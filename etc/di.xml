<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Loki\Components\Validator\ValidatorRegistry">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="password_complexity" xsi:type="object">Loki\Field\Validator\PasswordComplexityValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Loki\Field\Util\Component\FieldTemplateLocator">
        <arguments>
            <argument name="fieldTypes" xsi:type="array">
                <item name="checkbox" xsi:type="string">Loki_FieldComponents::form/field/checkbox.phtml</item>
                <item name="input" xsi:type="string">Loki_FieldComponents::form/field/input.phtml</item>
                <item name="password" xsi:type="string">Loki_FieldComponents::form/field/password.phtml</item>
                <item name="password_repeat" xsi:type="string">Loki_FieldComponents::form/field/password-repeat.phtml</item>
                <item name="radio" xsi:type="string">Loki_FieldComponents::form/field/radio.phtml</item>
                <item name="range" xsi:type="string">Loki_FieldComponents::form/field/range.phtml</item>
                <item name="select" xsi:type="string">Loki_FieldComponents::form/field/select.phtml</item>
                <item name="switch" xsi:type="string">Loki_FieldComponents::form/field/switch.phtml</item>
                <item name="text" xsi:type="string">Loki_FieldComponents::form/field/input.phtml</item>
                <item name="textarea" xsi:type="string">Loki_FieldComponents::form/field/textarea.phtml</item>
            </argument>
        </arguments>
    </type>
</config>
