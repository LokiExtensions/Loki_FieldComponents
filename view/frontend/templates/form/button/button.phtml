<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\ImageRenderer;
use Loki\Components\Factory\ViewModelFactory;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Util\ButtonInterface;

/** @version 2.2.18 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var ButtonInterface|FieldViewModel $viewModel */
/** @var CssClass $css */
/** @var ImageRenderer $imageRenderer */
/** @var ChildRenderer $childRenderer */

$buttonHint = $block->getButtonHint();
?>
<button class="<?= /* @noEscape */ $css('btn flex justify-center items-center') ?>"
        :class="cssClass"
        type="button"
        :disabled="disabled"
        x-ref="button"
        @click.prevent="submit"
        <?php if ($buttonHint) : ?>
        aria-describedby="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>-button-hint"
    <?php endif; ?>
>
    <?= /* @noEscape */ $childRenderer->html($block, 'icon'); ?>
    <?= $escaper->escapeHtml(__((string)$viewModel->getButtonLabel())) ?>
</button>

<?php if ($buttonHint) : ?>
    <div
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>-button-hint"
        class="<?= $escaper->escapeHtml($css('hidden', 'hint')) ?>"
        aria-hidden="true"
    >
        <?= $escaper->escapeHtml(__($buttonHint)) ?>
    </div>
<?php endif; ?>
