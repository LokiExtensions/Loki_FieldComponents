<?php
declare(strict_types=1);

/** @version 2.2.1 */

use Loki\Components\Util\Block\CssStyle;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\TemplateRenderer;
use Loki\Field\Field\FieldTypeManager;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var CssStyle $style */
/** @var ViewModelFactory $viewModelFactory */
/** @var TemplateRenderer $templateRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var FieldViewModel $viewModel */
/** @var FieldTypeManager $fieldTypeManager */

$fieldTypeManager = $viewModelFactory->create(FieldTypeManager::class);
?>
<div class="<?= /* @noEscape */ $css('field w-auto relative') ?> <?= $viewModel->isRequired() ? 'required' : 'optional' ?> <?= $escaper->escapeHtml(
    $viewModel->getFieldName()
) ?>" style="<?= $escaper->escapeHtml($style()) ?>">
    <?= /* @noEscape */ $block->getChildHtml('before') ?>

    <?= /* @noEscape */ $templateRenderer->html(
        $block,
        'Loki_FieldComponents::form/field/label.phtml',
        ['alias' => 'label'],
        $block
    ) ?>

    <div class="<?= /* @noEscape */ $css('flex', 'container') ?>">
        <div class="<?= /* @noEscape */ $css('relative grow', 'field') ?>">
            <?= /* @noEscape */ $templateRenderer->html(
                $block,
                $fieldTypeManager->getFieldTemplateFromViewModel($viewModel),
                $viewModel->getFieldData()
            ) ?>

            <div x-cloak x-show="showLoader"
                 class="<?= /* @noEscape */ $css('field-loader flex absolute inset-y-0 right-0 p-3', 'loader') ?>">
                <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader') ?>
            </div>
        </div>

        <?php if ($viewModel->getHelpText()): ?>
            <div class="<?= /* @noEscape */ $css('relative grow-0 flex content-center', 'field') ?>">
                <?= /* @noEscape */ $templateRenderer->html(
                    $block,
                    'Loki_FieldComponents::utils/help.phtml',
                    [
                        'alias' => 'help',
                        'help_text' => $viewModel->getHelpText(),
                    ]
                ) ?>
            </div>
        <?php endif; ?>
    </div>

    <?php if ($viewModel->getComment()): ?>
        <div class="<?= /* @noEscape */ $css('text-sm', 'comment') ?>">
            <?= /* @noEscape */ $viewModel->getComment() ?>
        </div>
    <?php endif; ?>

    <?= /* @noEscape */ $blockRenderer->html(
        $block,
        'loki-components.utils.local-messages',
        ['dom_id' => $viewModel->getElementId().'-messages',]
    ) ?>

    <?= /* @noEscape */ $block->getChildHtml('after') ?>
</div>
