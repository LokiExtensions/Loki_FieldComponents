<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var FieldViewModel $viewModel */

$viewModel = $block->getViewModel();
?>
<div class="<?= /* @noEscape */ $css('') ?>"
     :aria-invalid="isAriaInvalid"
     :data-valid="isValid"
     data-type="field">

    <input
        type="checkbox"
        id="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-field-input"
        :value="value"
        @change="submitValue"
        value="<?= $escaper->escapeHtml($viewModel->getValue()) ?>"
        <?php if ($viewModel->getValue() === true): ?>
            checked
        <?php endif; ?>
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
        class="<?= /* @noEscape */ $css('peer hidden', 'input') ?>"
    />

    <div class="<?= /* @noEscape */ $css('relative inline-block w-10 h-6', 'button') ?>">
        <div
            @click="value = !value; post()"
            :class="value ? 'bg-primary' : 'bg-gray-200'"
            class="<?= /* @noEscape */ $css('rounded-full absolute p-1 top-0 left-0 right-0 bottom-0 cursor-pointer', 'button-inner') ?>">
            <div
                :class="value ? 'float-left' : 'float-right'"
                class="<?= /* @noEscape */ $css('cursor-pointer h-4 w-4 rounded-full bg-white', 'button-active') ?>"></div>
        </div>
    </div>

    <label class="<?= /* @noEscape */ $css('inline-flex items-center cursor-pointer', 'label') ?>">
        <span class="<?= /* @noEscape */ $css('ms-3 text-sm font-medium text-gray-900 dark:text-gray-300"', 'label-inner') ?>">
            <?= $escaper->escapeHtml(__($viewModel->getInputLabel())) ?>
        </span>
    </label>
</div>
