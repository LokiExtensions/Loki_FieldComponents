<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Component\ComponentViewModelInterface;

/** @version 2.2.46 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var FieldViewModel $viewModel */

$viewModel = $block->getViewModel();
?>
<label
    data-type="field"
    class="<?= /* @noEscape */ $css('flex items-center gap-3') ?>"
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
>
    <input
        class="<?= /* @noEscape */ $css('form-switch', 'input') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            'role' => 'switch',
            'type' => 'checkbox',
            'value' => '1',
            'checked' => in_array($viewModel->getValue(), [true, 1, '1'], true),
            ':checked' => 'value',
            '@change' => 'submitChecked',
        ]) ?>
    >
    <span class="<?= /* @noEscape */ $css('', 'label') ?>">
        <?= $escaper->escapeHtml(__($viewModel->getInputLabel())) ?>
    </span>
</label>
