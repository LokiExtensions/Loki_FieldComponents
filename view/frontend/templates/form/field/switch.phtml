<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var FieldViewModel $viewModel */

$viewModel = $block->getViewModel();
?>
<div class="<?= /* @noEscape */ $css('relative inline-block') ?>"
     x-data="LokiSwitch"
     :aria-invalid="isAriaInvalid"
     :data-valid="isValid"
     data-type="field">

    <input
        type="checkbox"
        role="switch"
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>-input"
        :value="value"
        @change="toggleSwitch"
        value="<?= $escaper->escapeHtml($viewModel->getValue()) ?>"
        <?php if ($viewModel->getValue() === true): ?>
            checked
        <?php endif; ?>
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
        class="<?= /* @noEscape */ $css('peer appearance-none w-11 h-[28px] checked:bg-none bg-slate-500 disabled:bg-slate-100 rounded-full checked:bg-primary cursor-pointer transition-colors duration-300 border-0"', 'input') ?>"
    />

    <label
        for="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>-input"
        @click="toggleSwitch"
        :class="labelClass"
        class="absolute top-[2px] w-[20px] h-[20px] m-[2px] bg-white rounded-full shadow-sm transition-transform duration-300 cursor-pointer"></label>
</div>
