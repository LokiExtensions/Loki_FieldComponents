<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var FieldViewModel $viewModel */

$viewModel = $block->getViewModel();
?>
<div class="<?= $css('') ?>"
     aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
     data-type="field">

    <input
        type="checkbox"
        id="<?= $viewModel->getElementId() ?>-field-input"
        :value="value"
        @change="submitValue"
        value="<?= $viewModel->getValue() ?>"
        <?php if ($viewModel->getValue() === true): ?>
            checked
        <?php endif; ?>
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        id="<?= $viewModel->getFieldId() ?>"
        class="<?= $css('peer hidden', 'input') ?>"
    />

    <div class="relative inline-block w-10 h-6">
        <div
            @click="value = !value; post()"
            :class="value ? 'bg-primary' : 'bg-gray-200'"
            class="rounded-full absolute p-1 top-0 left-0 right-0 bottom-0 cursor-pointer ">
            <div
                :class="value ? 'float-left' : 'float-right'"
                class="cursor-pointer h-4 w-4 rounded-full bg-white"></div>
        </div>
    </div>

    <label class="inline-flex items-center cursor-pointer">
    <span class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300"><?= __(
            $viewModel->getInputLabel()
        ) ?></span>
    </label>

</div>
