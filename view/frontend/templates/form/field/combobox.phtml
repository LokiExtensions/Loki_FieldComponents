<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Util\Block\TemplateRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Field\Util\OptionGroupInterface;
use Loki\Field\Util\OptionModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.2.46 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModel $viewModel */
/** @var TemplateRenderer $templateRenderer */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $viewModel->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo $escaper->escapeHtml(__('No options found'));
    return;
}

$listboxId = $viewModel->getFieldId() . '-listbox';
?>
<div
    class="<?= /* @noEscape */ $css('relative w-full') ?>"
    x-data="LokiCombobox"
    <?php if ($viewModel->getPlaceholder()): ?>
    x-init="placeholder = placeholder || <?= $escaper->escapeHtmlAttr(json_encode($viewModel->getPlaceholder())) ?>"
    <?php endif; ?>
>
    <div class="<?= /* @noEscape */ $css('relative', 'input-container') ?>">
        <input
            id="<?= $escaper->escapeHtmlAttr($viewModel->getFieldId()) ?>"
            x-ref="field"
            x-model="query"
            @focus="openList()"
            @click="openList()"
            @input="onInput()"
            @keydown.arrow-down.prevent="moveDown()"
            @keydown.arrow-up.prevent="moveUp()"
            @keydown.enter.prevent="selectActive()"
            @keydown.escape.prevent="closeList()"
            @keydown.tab="closeList()"
            type="text"
            autocomplete="off"
            role="combobox"
            aria-label="<?= $escaper->escapeHtmlAttr((string)__($viewModel->getFieldLabel())) ?>"
            aria-controls="<?= $escaper->escapeHtmlAttr($listboxId) ?>"
            aria-errormessage="<?= $escaper->escapeHtmlAttr($viewModel->getElementId()) ?>-messages"
            aria-autocomplete="list"
            :aria-expanded="open"
            :aria-invalid="isAriaInvalid"
            :data-valid="isValid"
            :disabled="disabled"
            :placeholder="placeholder"
            <?= $viewModel->isDisabled() ? 'disabled' : '' ?>
            <?= $viewModel->isRequired() ? 'aria-required="true"' : '' ?>
            class="<?= /* @noEscape */ $css('form-input w-full pr-10 disabled:bg-zinc-100', 'input') ?>"
        >

        <button
            type="button"
            @click="toggle()"
            :disabled="disabled"
            class="<?= /* @noEscape */ $css('absolute inset-y-0 right-0 flex items-center px-3 text-gray-500', 'toggle') ?>"
            tabindex="-1"
            aria-label="<?= $escaper->escapeHtmlAttr((string)__('Toggle options')) ?>"
        >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
            </svg>
        </button>
    </div>

    <ul
        id="<?= $escaper->escapeHtmlAttr($listboxId) ?>"
        x-cloak
        x-show="open"
        x-transition.origin.top.left
        @click.outside="closeList()"
        class="<?= /* @noEscape */ $css('absolute z-50 mt-1 max-h-60 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg', 'listbox') ?>"
        role="listbox"
    >
        <template x-if="filteredOptions().length === 0">
            <li class="<?= /* @noEscape */ $css('px-3 py-2 text-gray-500', 'no-results') ?>">
                <?= $escaper->escapeHtml(__('No results found')) ?>
            </li>
        </template>

        <template x-for="(option, index) in filteredOptions()" :key="option.value">
            <li
                @mouseenter="activeIndex = index"
                @mousedown.prevent="selectOption(option)"
                :class="index === activeIndex ? 'bg-primary text-white' : 'bg-white text-gray-900'"
                class="<?= /* @noEscape */ $css('cursor-pointer px-3 py-2', 'option') ?>"
                role="option"
                :aria-selected="option.value === selectedValue"
            >
                <span x-text="option.label"></span>
            </li>
        </template>
    </ul>

    <select
        class="<?= /* @noEscape */ $css('form-select hidden', 'select') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            'id' => $viewModel->getFieldId() . '-select',
            'name' => $viewModel->getFieldName(),
            'x-ref' => 'select',
            'tabindex' => '-1',
            'aria-hidden' => 'true',
            'required' => false,
            ':value' => 'value',
            '@change' => 'submitSelectedOptions',
        ]) ?>
    >
        <?php foreach ($optionModel->getOptions($viewModel) as $optionIndex => $option): ?>
            <?php $subOptions = $option instanceof OptionGroupInterface
                ? (array)(method_exists($option, 'getOptions') ? $option->getOptions() : [])
                : [$optionIndex => $option]; ?>
            <?php foreach ($subOptions as $subOptionIndex => $subOption): ?>
                <?= /* @noEscape */ $templateRenderer->html(
                    $block,
                    'Loki_FieldComponents::form/field/select/option.phtml',
                    [
                        'option' => $subOption,
                        'option_index' => $subOptionIndex,
                    ]
                ) ?>
            <?php endforeach; ?>
        <?php endforeach; ?>
    </select>
</div>
