<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiFieldComponents\Component\Base\Field\FieldViewModel;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiFieldComponents\ViewModel\ImageOutput;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$imageOutput = $viewModelFactory->create(ImageOutput::class)
?>
<div class="<?= $css('w-full') ?>" x-data="LokiPasswordRepeat">
    <div class="<?= $css('relative w-full mb-4') ?>">
        <input
            aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
            data-type="field"
            x-ref="field"
            :value="password1"
            @input="setPassword1"
            @change="matchPasswords"
            <?php if ($viewModel->isDisabled()): ?>
                disabled="disabled"
            <?php endif ?>
            <?php if ($viewModel->hasAutocomplete()): ?>
                autocomplete="<?= $viewModel->getAutocomplete() ?>"
            <?php endif ?>
            <?= $viewModel->isRequired() ? 'required' : '' ?>
            :type="inputType"
            id="<?= $viewModel->getFieldId() ?>"
            class="<?= $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
        >

        <button @click="toggle" class="absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer" x-cloak
                x-show="isShown">
            <?= $imageOutput->get('Yireo_LokiFieldComponents::images/eye-slash.svg') ?>
        </button>

        <button @click="toggle" class="absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer" x-show="isHidden">
            <?= $imageOutput->get('Yireo_LokiFieldComponents::images/eye.svg') ?>
        </button>
    </div>
    <div>
        <input
            aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
            :value="password2"
            @input="setPassword2"
            @change="matchPasswords"
            <?php if ($viewModel->isDisabled()): ?>
                disabled="disabled"
            <?php endif ?>
            <?php if ($viewModel->hasAutocomplete()): ?>
                autocomplete="<?= $viewModel->getAutocomplete() ?>"
            <?php endif ?>
            <?= $viewModel->isRequired() ? 'required' : '' ?>
            :type="inputType"
            class="<?= $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
        >
    </div>
</div>
