<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.2.6 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */
/** @var CssClass $css */

$viewModel = $block->getViewModel();

?>
<div class="<?= /* @noEscape */ $css('w-full') ?>" x-data="LokiPasswordRepeat">
    <div class="<?= /* @noEscape */ $css('relative w-full mb-4') ?>">
        <input
            class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
            <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
                ':value' => 'password1',
                '@input' => 'setPassword1',
                '@change' => 'matchPasswords',
                ':type' => 'inputType',
            ]) ?>
        >

        <button
            @click.prevent="toggle"
            class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 fill-black cursor-pointer', 'button-hide') ?>"
            x-cloak
            x-show="isShown">
            <?= /* @noEscape */ $imageRenderer->icon($block, 'eye-slash') ?>
        </button>

        <button
            @click.prevent="toggle"
            class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 fill-black cursor-pointer', 'button-show') ?>"
            x-show="isHidden">
            <?= /* @noEscape */ $imageRenderer->icon($block, 'eye') ?>
        </button>
    </div>
    <div>
        <input
            :aria-invalid="isAriaInvalid"
            :data-valid="isValid"
            :value="password2"
            @input="setPassword2"
            @change="matchPasswords"
            <?php if ($viewModel->isDisabled()): ?>
                disabled="disabled"
            <?php endif ?>
            <?php if ($viewModel->hasAutocomplete()): ?>
                autocomplete="<?= $escaper->escapeHtml($viewModel->getAutocomplete()) ?>"
            <?php endif ?>
            <?= $viewModel->isRequired() ? 'required' : '' ?>
            :type="inputType"
            class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
        >
    </div>
</div>
