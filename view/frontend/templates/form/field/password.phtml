<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.2.26 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */
/** @var CssClass $css */

$viewModel = $block->getViewModel();

$buttonLabelHide = (string)$block->getButtonLabelHide();
if (empty($buttonLabelHide)) {
    $buttonLabelHide = 'Hide Password';
}

$buttonLabelShow = (string)$block->getButtonLabelShow();
if (empty($buttonLabelShow)) {
    $buttonLabelShow = 'Show Password';
}
?>
<div class="<?= /* @noEscape */ $css('relative w-full') ?>" x-data="LokiPassword">
    <input
        class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            ':value' => 'value',
            'value' => $viewModel->getValue(),
            '@input' => 'setValue',
            '@change' => 'submit',
            ':type' => 'inputType',
        ]) ?>
    >

    <button
        title="<?= $escaper->escapeHtml(__($buttonLabelHide)) ?>"
        @click.prevent="toggle"
        class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 fill-black cursor-pointer', 'button-hide') ?>"
        x-cloak
        x-show="isShown">
        <?= /* @noEscape */ $imageRenderer->icon($block, 'eye-slash') ?>
    </button>

    <button
        title="<?= $escaper->escapeHtml(__($buttonLabelShow)) ?>"
        @click.prevent="toggle"
        class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 fill-black cursor-pointer', 'button-show') ?>"
        x-show="isHidden">
        <?= /* @noEscape */ $imageRenderer->icon($block, 'eye') ?>
    </button>
</div>
