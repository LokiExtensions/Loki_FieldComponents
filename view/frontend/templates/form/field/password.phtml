<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Field\ViewModel\ImageOutput;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$imageOutput = $viewModelFactory->create(ImageOutput::class);

$buttonLabelHide = (string)$block->getButtonLabelHide();
if (empty($buttonLabelHide)) {
    $buttonLabelHide = 'Hide Password';
}

$buttonLabelShow = (string)$block->getButtonLabelShow();
if (empty($buttonLabelShow)) {
    $buttonLabelShow = 'Show Password';
}
?>
<div class="<?= $css('relative w-full') ?>" x-data="LokiPassword">
    <input
        :aria-invalid="isAriaInvalid"
        aria-errormessage="<?= $viewModel->getElementId() ?>-messages"
        data-type="field"
        x-ref="field"
        :value="value"
        @input="setValue"
        @change="submit"
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        <?php if ($viewModel->hasAutocomplete()): ?>
            autocomplete="<?= $viewModel->getAutocomplete() ?>"
        <?php endif ?>
        <?= $viewModel->isRequired() ? 'required' : '' ?>
        :type="inputType"
        id="<?= $viewModel->getFieldId() ?>"
        class="<?= $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
    >

    <button
        title="<?= __($buttonLabelHide) ?>"
        @click="toggle"
        class="<?= $css('absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer', 'button-hide') ?>"
        x-cloak
        x-show="isShown">
        <?= $imageOutput->get('Loki_FieldComponents::images/eye-slash.svg') ?>
    </button>

    <button
        title="<?= __($buttonLabelShow) ?>"
        @click="toggle"
        class="<?= $css('absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer', 'button-show') ?>"
        x-show="isHidden">
        <?= $imageOutput->get('Loki_FieldComponents::images/eye.svg') ?>
    </button>
</div>
