<?php
declare(strict_types=1);

/** @version 2.1.0 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\ViewModel\ImageOutput;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$imageOutput = $viewModelFactory->create(ImageOutput::class);

$buttonLabelHide = (string)$block->getButtonLabelHide();
if (empty($buttonLabelHide)) {
    $buttonLabelHide = 'Hide Password';
}

$buttonLabelShow = (string)$block->getButtonLabelShow();
if (empty($buttonLabelShow)) {
    $buttonLabelShow = 'Show Password';
}
?>
<div class="<?= /* @noEscape */ $css('relative w-full') ?>" x-data="LokiPassword">
    <input
        class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100', 'field') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            ':value' => 'value',
            '@input' => 'setValue',
            '@change' => 'submit',
            ':type' => 'inputType',
        ]) ?>
    >

    <button
        title="<?= $escaper->escapeHtml(__($buttonLabelHide)) ?>"
        @click="toggle"
        class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer', 'button-hide') ?>"
        x-cloak
        x-show="isShown">
        <?= /* @noEscape */ $imageOutput->get('Loki_FieldComponents::images/eye-slash.svg') ?>
    </button>

    <button
        title="<?= $escaper->escapeHtml(__($buttonLabelShow)) ?>"
        @click="toggle"
        class="<?= /* @noEscape */ $css('absolute inset-y-0 end-4 z-20 w-4 fill-black cursor-pointer', 'button-show') ?>"
        x-show="isHidden">
        <?= /* @noEscape */ $imageOutput->get('Loki_FieldComponents::images/eye.svg') ?>
    </button>
</div>
