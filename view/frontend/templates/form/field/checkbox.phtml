<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var FieldViewModel $viewModel */

$viewModel = $block->getViewModel();
?>
<label
    data-type="field"
    class="<?= /* @noEscape */ $css('flex items-center gap-3') ?>"
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
>
    <input
        type="checkbox"
        id="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-field-input"
        class="<?= /* @noEscape */ $css('form-checkbox', 'input') ?>"
        value="<?= $escaper->escapeHtml($viewModel->getValue()) ?>"
        <?php if ($viewModel->getValue() === true): ?>checked<?php endif; ?>
        :checked="value"
        <?php if ($viewModel->isDisabled()): ?>disabled<?php endif ?>
        :aria-invalid="isAriaInvalid"
        :data-valid="isValid"
        @change="submitChecked"
    >
    <span class="<?= /* @noEscape */ $css('', 'label') ?>">
        <?= $escaper->escapeHtml(__($viewModel->getInputLabel())) ?>
    </span>
</label>
