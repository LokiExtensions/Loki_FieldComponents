<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Field\Config\Config;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Field\FieldTypeManager;

/** @version 2.2.49 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var Config $config */
/** @var FieldTypeManager $fieldTypeManager */
/** @var FieldViewModel $viewModel */

$fieldTypeManager = $viewModelFactory->create(FieldTypeManager::class);
$config = $viewModelFactory->create(Config::class);
$viewModel = $block->getViewModel();
$showFieldLabel = $viewModel->showFieldLabel();
$useLabelTag = $viewModel->useLabelTagForLabel($block) && $showFieldLabel;
$fieldLabel = $viewModel->getFieldLabel();
?>
<?php if ($useLabelTag): ?>
    <label
        for="<?= $escaper->escapeHtmlAttr($viewModel->getFieldId()) ?>"
        class="<?= /* @noEscape */ $css('label inline-block mt-2 md:mt-0 mb-1.5', 'label') ?>">
        <?= $escaper->escapeHtml(__($fieldLabel)) ?>

        <?php if ($viewModel->isRequired() && $config->useRequiredBlock()): ?>
            <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.required'); ?>
        <?php endif; ?>
    </label>
<?php elseif($showFieldLabel): ?>
    <span class="<?= /* @noEscape */ $css('label inline-block mt-2 md:mt-0 mb-1.5', 'label') ?>">
        <?= $escaper->escapeHtml(__($fieldLabel)) ?>

        <?php if ($viewModel->isRequired() && $config->useRequiredBlock()): ?>
            <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.required'); ?>
        <?php endif; ?>
    </span>
<?php else: ?>
    <span class="<?= /* @noEscape */ $css('label inline-block mt-2 md:mt-0 mb-1.5', 'label') ?>">
        &nbsp;
    </span>
<?php endif; ?>
