<?php
declare(strict_types=1);

/** @version 2.0.13 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Field\Config\Config;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\Util\Component\FieldTemplateLocator;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var Config $config */
/** @var FieldTemplateLocator $fieldTemplateLocator */
/** @var FieldViewModel $viewModel */

$fieldTemplateLocator = $viewModelFactory->create(FieldTemplateLocator::class);
$config = $viewModelFactory->create(Config::class);
$viewModel = $block->getViewModel();
$isLabel = false === in_array($fieldTemplateLocator->getFieldTypeFromViewModel($viewModel), ['radio']); // @todo: Move this to the ViewModel
?>
<?php if ($isLabel): ?>
    <label
        for="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-field"
        class="<?= /* @noEscape */ $css('inline-block mt-2 md:mt-0 mb-1.5', 'label') ?>">
        <?= $escaper->escapeHtml(__($viewModel->getFieldLabel())) ?>

        <?php if ($viewModel->isRequired() && $config->useRequiredBlock()): ?>
            <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.required'); ?>
        <?php endif; ?>
    </label>
<?php else: ?>
    <span class="<?= /* @noEscape */ $css('inline-block mt-2 md:mt-0 mb-1.5', 'label') ?>">
        <?= $escaper->escapeHtml(__($viewModel->getFieldLabel())) ?>

        <?php if ($viewModel->isRequired() && $config->useRequiredBlock()): ?>
            <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.required'); ?>
        <?php endif; ?>
    </span>

<?php endif; ?>
