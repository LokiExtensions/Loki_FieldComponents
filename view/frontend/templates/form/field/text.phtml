<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$fieldBlock = $block->getFieldBlock(); // @todo $fieldBlock is empty?
$viewModel = $block->getViewModel();
$ancestorBlock = $viewModel->getBlock();
$mask = $ancestorBlock->getInputMask(); // @todo: Move to Field class
$inputPrefix = $ancestorBlock->getInputPrefix(); // @todo: Move to Field class

// @todo: Move inputPrefix HTML to separate template
?>
<div class="<?= $css('w-full flex') ?>">
    <?php if ($inputPrefix): ?>
        <div class="<?= $css('', 'input_prefix') ?>">
            <?php if (str_ends_with($inputPrefix, '.svg')): ?>
            <img
                src="<?= $block->getViewFileUrl($inputPrefix); ?>"
                class="<?= $css('', 'input_prefix_icon') ?>"
                alt=""
            >
            <?php else: ?>
                <?= $inputPrefix ?>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <input
        aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
        data-type="field"
        x-ref="field"
        :value="value"
        @input="setValue"
        @change="submit"
        :disabled="disabled"
        <?php if ($mask): ?>
            x-mask="<?= $mask ?>"
        <?php endif; ?>
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        <?php if ($viewModel->hasAutocomplete()): ?>
            autocomplete="<?= $viewModel->getAutocomplete() ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMinLength()): ?>
            minlength="<?= $viewModel->getMinLength() ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMaxLength()): ?>
            maxlength="<?= $viewModel->getMaxLength() ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMin()): ?>
            min="<?= $viewModel->getMin() ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMax()): ?>
            max="<?= $viewModel->getMax() ?>"
        <?php endif ?>
        <?php if ($viewModel->getPlaceholder()): ?>
            placeholder="<?= __($viewModel->getPlaceholder()) ?>"
        <?php endif ?>
        <?= $viewModel->isRequired() ? 'required' : '' ?>
        type="<?= $viewModel->getInputType() ?>"
        id="<?= $viewModel->getFieldId() ?>"
        class="<?= $css('form-input w-full disabled:bg-zinc-100', 'input') ?>"
    >
    <div x-show="isCompleted" class="<?= $css('absolute right-0', 'required') ?>">
        <?= $blockRenderer->html($block, 'loki-components.utils.field-completed') ?>
    </div>
</div>
