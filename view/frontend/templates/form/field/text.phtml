<?php
declare(strict_types=1);

/** @version 2.0.16 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$fieldBlock = $block->getFieldBlock(); // @todo $fieldBlock is empty?
$viewModel = $block->getViewModel();
$ancestorBlock = $viewModel->getBlock();
$mask = $ancestorBlock->getInputMask(); // @todo: Move to Field class
$inputPrefix = $ancestorBlock->getInputPrefix(); // @todo: Move to Field class

// @todo: Move inputPrefix HTML to separate template
?>
<div class="<?= /* @noEscape */ $css('w-full flex') ?>">
    <?php if ($inputPrefix): ?>
        <div class="<?= /* @noEscape */ $css('', 'input_prefix') ?>">
            <?php if (str_ends_with($inputPrefix, '.svg')): ?>
            <img
                src="<?= /* @noEscape */ $block->getViewFileUrl($inputPrefix); ?>"
                class="<?= /* @noEscape */ $css('', 'input_prefix_icon') ?>"
                alt=""
            >
            <?php else: ?>
                <?= /* @noEscape */ $inputPrefix ?>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <input
        :aria-invalid="isAriaInvalid"
        :data-valid="isValid"
        aria-errormessage="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-messages"
        data-type="field"
        x-ref="field"
        :value="value"
        @input="setValue"
        @change="submit"
        :disabled="disabled"
        <?php if ($mask): ?>
            x-mask="<?= $escaper->escapeHtml($mask) ?>"
        <?php endif; ?>
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        <?php if ($viewModel->hasAutocomplete()): ?>
            autocomplete="<?= $escaper->escapeHtml($viewModel->getAutocomplete()) ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMinLength()): ?>
            minlength="<?= $escaper->escapeHtml($viewModel->getMinLength()) ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMaxLength()): ?>
            maxlength="<?= $escaper->escapeHtml($viewModel->getMaxLength()) ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMin()): ?>
            min="<?= $escaper->escapeHtml($viewModel->getMin()) ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMax()): ?>
            max="<?= $escaper->escapeHtml($viewModel->getMax()) ?>"
        <?php endif ?>
        <?php if ($viewModel->getPlaceholder()): ?>
            placeholder="<?= $escaper->escapeHtml(__($viewModel->getPlaceholder())) ?>"
        <?php endif ?>
        <?php if ($viewModel->getAlpineMask()): ?>
            x-mask="<?= $escaper->escapeHtml(__($viewModel->getAlpineMask())) ?>"
        <?php endif ?>
        <?= $viewModel->isRequired() ? 'required' : '' ?>
        type="<?= $escaper->escapeHtml($viewModel->getInputType()) ?>"
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
        class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100', 'input') ?>"
    >
    <div x-show="isCompleted" class="<?= /* @noEscape */ $css('absolute right-0', 'required') ?>">
        <?= /* @noEscape */ $blockRenderer->html($block, 'loki-components.utils.field-completed') ?>
    </div>
</div>
