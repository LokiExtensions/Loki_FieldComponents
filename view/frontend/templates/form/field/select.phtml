<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiFieldComponents\Component\Base\Field\FieldViewModelInterface;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiFieldComponents\Util\OptionModelInterface;

/** @var Template $block */
/** @var FieldViewModelInterface $viewModel */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $viewModel->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo __('No options found');
    return;
}

$ancestorBlock = $viewModel->getBlock();
$multiple = (bool) $ancestorBlock->getMultiple();
$size = (int) $ancestorBlock->getSize();
$autocomplete = (bool) $ancestorBlock->getAutocomplete();

// @todo: Check disabled state
// @todo: Check aria-busy
?>
<select
    data-type="field"
    x-ref="field"
    x-model="value"
    @change="submit"
    aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    :disabled="disabled"
    <?php if ($multiple): ?>
        multiple
    <?php endif; ?>
    <?php if ($size > 0): ?>
        size="<?= $size ?>"
    <?php endif; ?>
    <?php if ($autocomplete): ?>
        autocomplete="<?= $autocomplete ?>"
    <?php endif; ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    id="<?= $viewModel->getFieldId() ?>"
    class="<?= $css('form-select w-full disabled:bg-zinc-100') ?>"
>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionValue => $optionLabel): ?>
        <option value="<?= $optionValue ?>"><?= $optionLabel ?></option>
    <?php endforeach; ?>
</select>
