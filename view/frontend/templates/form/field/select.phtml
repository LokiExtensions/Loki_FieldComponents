<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Util\Block\TemplateRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Component\Base\Field\FieldViewModelInterface;
use Loki\Field\Util\OptionGroupInterface;
use Loki\Field\Util\OptionGroupModelInterface;
use Loki\Field\Util\OptionInterface;
use Loki\Field\Util\OptionModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.2.35 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModelInterface $viewModel */
/** @var TemplateRenderer $templateRenderer */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $viewModel->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo $escaper->escapeHtml(__('No options found'));
    return;
}
?>
<div class="<?= /* @noEscape */ $css('') ?>">
    <select
        class="<?= /* @noEscape */ $css('form-select w-full disabled:bg-zinc-100') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            ':value' => 'value',
            '@change' => 'submitSelectedOptions',
        ]) ?>
    >
        <?php foreach ($optionModel->getOptions($viewModel) as $option): ?>
            <?php if ($option instanceof OptionGroupInterface): ?>
            <optgroup
                label="<?= $option->getLabel() ?>"
                <?= $option->isDisabled() ? 'disabled' : '' ?>
            >
                <?php foreach ($option->getOptions() as $subOptionIndex => $subOption): ?>
                    <?= $templateRenderer->html(
                        $block,
                        'Loki_FieldComponents::form/field/select/option.phtml',
                        ['option' => $subOption]
                    ) ?>
                <?php endforeach; ?>
            </optgroup>
            <?php else: ?>
                <?= $templateRenderer->html(
                    $block,
                    'Loki_FieldComponents::form/field/select/option.phtml',
                    ['option' => $option]
                ) ?>
            <?php endif; ?>
        <?php endforeach; ?>
    </select>
</div>
