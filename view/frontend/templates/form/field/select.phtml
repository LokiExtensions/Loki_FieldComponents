<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Util\OptionModelInterface;

/** @version 2.2.16 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModelInterface $viewModel */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $viewModel->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo $escaper->escapeHtml(__('No options found'));
    return;
}
?>
<select
    class="<?= /* @noEscape */ $css('form-select w-full disabled:bg-zinc-100') ?>"
    <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
        ':value' => 'value',
        '@change' => 'submitSelectedOptions',
    ]) ?>
>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionValue => $optionLabel): ?>
        <option
            value="<?= $escaper->escapeHtml($optionValue) ?>"
            <?= $optionValue === $viewModel->getValue() ? 'selected' : '' ?>
        >
            <?= $escaper->escapeHtml($optionLabel) ?>
        </option>
    <?php endforeach; ?>
</select>
