<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<input
    aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
    data-type="field"
    x-ref="field"
    :value="value"
    @change="submitValue"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($viewModel->hasAutocomplete()): ?>
        autocomplete="<?= $viewModel->getAutocomplete() ?>"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    type="file"
    id="<?= $viewModel->getFieldId() ?>"
    class="<?= $css('form-input w-full disabled:bg-zinc-100') ?>"
>
