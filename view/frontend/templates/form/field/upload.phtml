<?php
declare(strict_types=1);

/** @version 2.0.10 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<input
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
    data-type="field"
    x-ref="field"
    :value="value"
    @change="submitValue"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($viewModel->hasAutocomplete()): ?>
        autocomplete="<?= $escaper->escapeHtml($viewModel->getAutocomplete()) ?>"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    type="file"
    id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
    class="<?= /* @noEscape */ $css('form-input w-full disabled:bg-zinc-100') ?>"
>
