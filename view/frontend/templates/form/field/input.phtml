<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;

/** @version 2.2.46 */
/** @var ComponentViewModelInterface $viewModel */
/** @var FieldViewModel $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var TemplateRenderer $templateRenderer */

$viewModel = $block->getViewModel();
$inputCss = 'input-'.$viewModel->getInputType(). ' form-input w-full disabled:bg-zinc-100';
?>
<div class="<?= /* @noEscape */ $css('w-full flex') ?>">
    <?= /* @noEscape */ $templateRenderer->html($block, 'Loki_FieldComponents::form/field/input/prefix.phtml') ?>

    <input
        class="<?= /* @noEscape */ $css($inputCss, 'input') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            'name' => $viewModel->getFieldName(),
            'type' => $viewModel->getInputType(),
            'value' => $viewModel->getValue(),
            ':value' => 'value',
            '@input' => 'setValue',
            '@change' => 'submit',
        ]) ?>
    >

    <div x-show="isCompleted">
        <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-components.utils.field-completed') ?>
    </div>
</div>
