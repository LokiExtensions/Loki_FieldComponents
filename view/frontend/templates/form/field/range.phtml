<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;

/** @version 2.2.42 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
$min = (int)$viewModel->getBlock()->getMin();
$max = (int)$viewModel->getBlock()->getMax();
?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?php if ($min > 0): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'min') ?>"><?= (int)$min ?></span>
    <?php endif ?>
    <input
        class="<?= /* @noEscape */ $css('disabled:bg-zinc-100') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            'type' => 'range',
            ':value' => 'value',
            '@input' => 'setValue',
            '@change' => 'submit',
        ]) ?>
    >
    <?php if ($max > 0): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'max') ?>"><?= (int)$max ?></span>
    <?php endif ?>

    <span class="<?= /* @noEscape */ $css('block text-sm w-full text-center', 'bubble') ?>" x-html="value"></span>
</div>
