<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiFieldComponents\Component\Base\Field\FieldViewModel;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<div class="<?= $css('relative') ?>">
    <?php if ($viewModel->hasMin()): ?>
    <span class="<?= $css('text-sm', 'min') ?>"><?= $viewModel->getMin() ?></span>
    <?php endif ?>
    <input
    aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
    data-type="field"
    x-ref="field"
    x-model.lazy="value"
    @change="submit"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($viewModel->hasMin()): ?>
        min="<?= $viewModel->getMin() ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMax()): ?>
        max="<?= $viewModel->getMax() ?>"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    type="range"
    id="<?= $viewModel->getFieldId() ?>"
    class="<?= $css('disabled:bg-zinc-100') ?>"
>
    <?php if ($viewModel->hasMax()): ?>
        <span class="<?= $css('text-sm', 'max') ?>"><?= $viewModel->getMax() ?></span>
    <?php endif ?>

    <span class="<?= $css('block text-sm w-full text-center', 'bubble') ?>" x-html="value"></span>
</div>
