<?php
declare(strict_types=1);

/** @version 2.0.16 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\CssUtils\Util\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?php if ($viewModel->hasMin()): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'min') ?>"><?= $escaper->escapeHtml($viewModel->getMin()) ?></span>
    <?php endif ?>
    <input
        class="<?= /* @noEscape */ $css('disabled:bg-zinc-100') ?>"
        <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
            'type' => 'range',
            ':value' => 'value',
            '@input' => 'setValue',
            '@change' => 'submit',
        ]) ?>
    >
    <?php if ((int)$viewModel->getBlock()->getMax() > 0): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'max') ?>"><?= (int)$viewModel->getBlock()->getMax() ?></span>
    <?php endif ?>

    <span class="<?= /* @noEscape */ $css('block text-sm w-full text-center', 'bubble') ?>" x-html="value"></span>
</div>
