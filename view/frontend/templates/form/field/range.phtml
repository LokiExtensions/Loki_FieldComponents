<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?php if ($viewModel->hasMin()): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'min') ?>"><?= $escaper->escapeHtml($viewModel->getMin()) ?></span>
    <?php endif ?>
    <input
        :aria-invalid="isAriaInvalid"
        aria-errormessage="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-messages"
        data-type="field"
        x-ref="field"
        :value="value"
        @input="setValue"
        @change="submit"
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        <?php if ($viewModel->hasMin()): ?>
            min="<?= $escaper->escapeHtml($viewModel->getMin()) ?>"
        <?php endif ?>
        <?php if ($viewModel->hasMax()): ?>
            max="<?= $escaper->escapeHtml($viewModel->getMax()) ?>"
        <?php endif ?>
        <?= $viewModel->isRequired() ? 'required' : '' ?>
        type="range"
        id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
        class="<?= /* @noEscape */ $css('disabled:bg-zinc-100') ?>"
    >
    <?php if ($viewModel->hasMax()): ?>
        <span class="<?= /* @noEscape */ $css('text-sm', 'max') ?>"><?= $escaper->escapeHtml($viewModel->getMax()) ?></span>
    <?php endif ?>

    <span class="<?= /* @noEscape */ $css('block text-sm w-full text-center', 'bubble') ?>" x-html="value"></span>
</div>
