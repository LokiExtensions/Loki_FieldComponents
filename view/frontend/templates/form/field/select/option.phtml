<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Component\Base\Field\FieldViewModelInterface;
use Loki\Field\Util\OptionValue;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.2.47 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldViewModelInterface $viewModel */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var OptionValue $optionValueUtil */

$optionValueUtil = $viewModelFactory->create(OptionValue::class);
$viewModel = $block->getViewModel();
$option = $block->getOption();
$optionIndex = $block->getOptionIndex() ?? '';
$optionLabel = $optionValueUtil->getLabel($option);
$optionValue = $optionValueUtil->getValue($option, $optionIndex);
$disabled = $optionValueUtil->isDisabled($option);
$selected = $optionValueUtil->isSelected($option, $optionIndex, $viewModel->getValue());
?>
<option
    value="<?= $escaper->escapeHtmlAttr($optionValue) ?>"
    <?= $disabled ? 'disabled' : '' ?>
    <?= $selected ? 'selected' : '' ?>
>
    <?= $escaper->escapeHtml($optionLabel) ?>
</option>
