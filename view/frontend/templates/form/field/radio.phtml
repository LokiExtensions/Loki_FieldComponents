<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Util\OptionModelInterface;
use Loki\Components\Component\ComponentViewModelInterface;

/** @version 2.2.24 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $block->getAncestorBlock()->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo $escaper->escapeHtml(__('No options found'));
    return;
}

?>
<div
    class="<?= /* @noEscape */ $css('grid grid-cols-1 md:grid-cols-2') ?>"
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
    data-type="field"
>
    <?php $i = 0; ?>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionValue => $optionLabel): ?>
        <label class="<?= /* @noEscape */ $css('flex items-center gap-3 cursor-pointer', 'option') ?>">
            <input
                class="<?= /* @noEscape */ $css('form-radio', 'input') ?>"
                <?= /* @noEscape */ $viewModel->getFieldAttributesAsString([
                    'type' => 'radio',
                    'id' => $viewModel->getElementId() . '-' . $optionValue,
                    'value' => $optionValue,
                    'checked' => $optionValue === $viewModel->getValue() ? true : false,
                    ':checked' => 'isChecked',
                    '@change' => 'submitValue',
                ]) ?>
            >
            <span class="<?= /* @noEscape */ $css('', 'label') ?>">
                <?= $escaper->escapeHtml(__($optionLabel)) ?>
            </span>
        </label>
        <?php $i++; ?>
    <?php endforeach; ?>
</div>
