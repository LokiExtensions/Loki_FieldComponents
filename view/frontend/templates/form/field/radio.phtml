<?php
declare(strict_types=1);

use Loki\Components\Util\Block\TemplateRenderer;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Field\Util\OptionGroupInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\Util\OptionModelInterface;
use Loki\Components\Component\ComponentViewModelInterface;

/** @version 2.2.48 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ComponentViewModelInterface $viewModel */
/** @var FieldViewModel $viewModel */
/** @var TemplateRenderer $templateRenderer */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $viewModel->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo $escaper->escapeHtml(__('No options found'));
    return;
}

?>
<div
    class="<?= /* @noEscape */ $css('grid grid-cols-1 md:grid-cols-2 py-2') ?>"
    role="radiogroup"
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
    data-type="field"
>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionIndex => $option): ?>
        <?php if ($option instanceof OptionGroupInterface): ?>
        <fieldset
            class="<?= /* @noEscape */ $css('col-span-full', 'option-group') ?>"
            <?= /* @noEscape */ $option->isDisabled() ? 'disabled' : '' ?>
        >
            <legend class="<?= /* @noEscape */ $css('', 'option-group-label') ?>">
                <?= $escaper->escapeHtml($option->getLabel()) ?>
            </legend>
            <?php foreach ((array)(method_exists($option, 'getOptions') ? $option->getOptions() : []) as $subOptionIndex => $subOption): ?>
                <?= /* @noEscape */ $templateRenderer->html(
                    $block,
                    'Loki_FieldComponents::form/field/radio/option.phtml',
                    [
                        'option_index' => $subOptionIndex,
                        'option' => $subOption
                    ]
                ) ?>
            <?php endforeach; ?>
        </fieldset>
        <?php else: ?>
        <?= /* @noEscape */ $templateRenderer->html(
            $block,
            'Loki_FieldComponents::form/field/radio/option.phtml',
            [
                'option' => $option,
                'option_index' => $optionIndex,
            ]
        ) ?>
        <?php endif; ?>
    <?php endforeach; ?>
</div>
