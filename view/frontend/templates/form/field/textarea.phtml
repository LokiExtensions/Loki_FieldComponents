<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Field\Component\Base\Field\FieldViewModel;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<textarea
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
    aria-errormessage="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-messages"
    data-type="field"
    x-ref="field"
    x-text="value"
    @input="setValue"
    @change="submit"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($viewModel->hasAutocomplete()): ?>
        autocomplete="<?= $escaper->escapeHtml($viewModel->getAutocomplete()) ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMinLength()): ?>
        minlength="<?= $escaper->escapeHtml($viewModel->getMinLength()) ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMaxLength()): ?>
        maxlength="<?= $escaper->escapeHtml($viewModel->getMaxLength()) ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMin()): ?>
        min="<?= $escaper->escapeHtml($viewModel->getMin()) ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMax()): ?>
        max="<?= $escaper->escapeHtml($viewModel->getMax()) ?>"
    <?php endif ?>
    <?php if ($viewModel->getPlaceholder()): ?>
        placeholder="<?= $escaper->escapeHtml($viewModel->getPlaceholder()) ?>"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    id="<?= $escaper->escapeHtml($viewModel->getFieldId()) ?>"
    class="<?= /* @noEscape */ $css('form-input w-full field-sizing-content disabled:bg-zinc-100', 'input') ?>"
><?= $escaper->escapeHtml($viewModel->getValue()) ?></textarea>
