<?php
declare(strict_types=1);

/** @version 2.1.1 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    LokiComponentValidator = {
        validators: {
            required: (component) => {
                isValid = true;
                if (component.value === '' || component.value === null || component.value === undefined) {
                    component.messages.push({type:'error', text: '<?= $escaper->escapeHtml(__('Value is required')) ?>'});
                    isValid = false;
                }

                return isValid;
            }
        },
        validate: function (component) {
            component.messages = [];

            if (!component.validators) {
                return true;
            }

            const isValid = component.validators.every(validator => {
                if (!this.validators[validator]) {
                    //LokiComponentsLogger.warning('Undefined validator', validator);
                    return true;
                }

                let isValid = true;
                const result = this.validators[validator](component);
                if (Boolean(result && typeof result.then === 'function')) {
                    result.then(value => {
                        isValid = value;
                    })
                } else {
                    isValid = result;
                }

                return isValid;
            });

            if (false === isValid) {
                this.setInvalid(component);
            } else {
                this.setValid(component);
            }

            return isValid;
        },
        setInvalid: function (component) {
            component.valid = false;
            if (component.$root) {
                const elements = component.$root.querySelectorAll('[data-type="field"]');
                elements.forEach(element => {
                    if (element.tagName === 'input') {
                        if (typeof element.setCustomValidity === 'function') {
                            element.setCustomValidity('Value is invalid');
                        }
                    }

                    element.setAttribute('aria-invalid', true);
                    document.dispatchEvent(new CustomEvent('loki-components.dom-update', {target: {element}}));
                });
            }

            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
        },
        setValid: function (component) {
            component.valid = true;
            if (component.$root) {
                Array.from(component.$root.getElementsByTagName('input')).forEach(element => {
                    if (component.submitted && typeof element.setCustomValidity === 'function') {
                        element.setCustomValidity('');
                    }

                    document.dispatchEvent(new CustomEvent('loki-components.dom-update', {target: {element}}));
                    element.removeAttribute('aria-invalid');
                });
            }

            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
        },
        findFirstInvalidElement: function() {
            return Object.values(document.querySelectorAll('[aria-invalid]'))
                .filter(htmlElement => !htmlElement.disabled)
                .shift();
        }
    }
</script>
