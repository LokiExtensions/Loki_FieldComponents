<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.2.46 */
/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    LokiComponentValidator = {
        validators: {
            required: (component) => {
                const value = component.value;
                const isEmpty = value === '' || value === null || value === undefined || value === false
                    || (typeof value === 'string' && value.trim() === '')
                    || (Array.isArray(value) && value.length === 0);

                if (!isEmpty) {
                    return true;
                }

                let errorMessage = '<?= $escaper->escapeJs((string)__('Value is required')) ?>';
                if (component.requiredErrorMessage) {
                    errorMessage = component.requiredErrorMessage;
                }

                component.messages.push({type:'error', text: errorMessage});
                return false;
            }
        },
        validate: function (component) {
            component.messages = [];

            if (component.skipValidation) {
                return true;
            }

            if (typeof component.validate === 'function') {
                return this.handleResult(component.validate(), component);
            }

            if (typeof component.onComponentValidate === 'function') {
                console.log('Loki Component method "onComponentValidate" is called but deprecated. Use "validate" instead.');
                return this.handleResult(component.onComponentValidate(), component);
            }

            if (typeof component.valid === 'undefined') {
                return true;
            }

            if (!component.validators) {
                return true;
            }

            const pendingResults = [];
            for (const validator of component.validators) {
                if (typeof this.validators[validator] !== 'function') {
                    continue;
                }

                const result = this.validators[validator](component);
                if (this.isPromise(result)) {
                    pendingResults.push(result);
                    continue;
                }

                if (!result) {
                    this.handleIsValid(false, component);
                    return false;
                }
            }

            if (pendingResults.length > 0) {
                return Promise.all(pendingResults).then(results => {
                    const isValid = results.every(result => Boolean(result));
                    this.handleIsValid(isValid, component);
                    return isValid;
                });
            }

            this.handleIsValid(true, component);
            return true;
        },
        isPromise(result) {
            return Boolean(result && typeof result.then === 'function');
        },
        handleResult(result, component) {
            if (this.isPromise(result)) {
                return result.then(isValid => {
                    this.handleIsValid(isValid, component);
                    return isValid;
                });
            }

            this.handleIsValid(result, component);
            return result;
        },
        handleIsValid(isValid, component) {
            if (false === isValid) {
                this.setInvalid(component);
            } else {
                this.setValid(component);
            }
        },
        getFieldElements(component) {
            if (!component.$root) {
                return [];
            }

            return Array.from(component.$root.querySelectorAll('[data-type="field"], input, select, textarea'));
        },
        setInvalid: function (component) {
            component.valid = false;
            if (component.$root) {
                if (['group', 'radiogroup'].includes(component.$root.getAttribute('role'))) {
                    component.$root.setAttribute('aria-invalid', true);
                }

                this.getFieldElements(component).forEach(element => {
                    if (typeof element.setCustomValidity === 'function') {
                        element.setCustomValidity('<?= $escaper->escapeJs((string)__('Value is invalid')) ?>');
                    }

                    if (element.matches('[data-type="field"]')) {
                        element.setAttribute('aria-invalid', true);
                    }

                    document.dispatchEvent(new CustomEvent('loki-components.dom-update', {detail: {element}}));
                });
            }

            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
        },
        setValid: function (component) {
            component.valid = true;
            if (component.$root) {
                if (['group', 'radiogroup'].includes(component.$root.getAttribute('role'))) {
                    component.$root.removeAttribute('aria-invalid');
                }

                this.getFieldElements(component).forEach(element => {
                    if (typeof element.setCustomValidity === 'function') {
                        element.setCustomValidity('');
                    }

                    element.removeAttribute('aria-invalid');
                    document.dispatchEvent(new CustomEvent('loki-components.dom-update', {detail: {element}}));
                });
            }

            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
        },
        findFirstInvalidElement: function() {
            return Object.values(document.querySelectorAll('[aria-invalid]'))
                .filter(htmlElement => !htmlElement.disabled)
                .shift();
        }
    }
</script>
