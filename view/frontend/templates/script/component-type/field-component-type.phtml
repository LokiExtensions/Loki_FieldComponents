<?php declare(strict_types=1); /** @version 2.1.1 */ use Magento\Framework\View\Element\Template; /** @var Template $block */ ?> <script>
    const LokiFieldComponentType = {
        ...LokiComponentType,
        fieldName: '',
        fieldValue: null,
        valid: true,
        disabled: false,
        submitted: false,
        validators: [],
        validationActions: {
            lokiComponentValidator() {
                return LokiComponentValidator.validate(this);
            }
        },
        initWatchFieldLoading() {
            if (this.$refs.field) {
                this.$refs.field.removeAttribute('aria-busy');

                if (!this.disabled) {
                    this.$refs.field.removeAttribute('disabled');
                }
            }

            this.$watch('loading', () => {
                if (!this.$refs.field) {
                    return;
                }

                if (this.loading) {
                    this.$refs.field.classList.add('loading');
                    this.$refs.field.setAttribute('aria-busy', true);
                    this.$refs.field.setAttribute('disabled', true);
                } else {
                    this.$refs.field.classList.remove('loading');
                    this.$refs.field.removeAttribute('aria-busy');

                    if (!this.disabled) {
                        this.$refs.field.removeAttribute('disabled');
                    }
                }
            });
        },
        initValidation() {
            if (!this.$refs.field) {
                return;
            }

            if (!this.isAriaInvalid()) {
                this.$refs.field.removeAttribute('aria-invalid');
            } else {
                this.$refs.field.setAttribute('aria-invalid', true);
            }

            this.$watch('valid', () => {
                if (!this.isAriaInvalid()) {
                    this.$refs.field.removeAttribute('aria-invalid');
                } else {
                    this.$refs.field.setAttribute('aria-invalid', true);
                }
            })
        },
        setValid(valid) {
            this.valid = valid;
            document.dispatchEvent(new CustomEvent('loki-components.component.update'));
        },
        isValid() {
            if (this.valid && this.value && this.value.length > 0) {
                return true;
            }

            return this.valid && this.isSubmitted();
        },
        isAriaInvalid() {
            return !this.valid && this.submitted;
        },
        isSubmitted() {
            return this.submitted || this.ajax;
        },
        beforeSubmit() {
        },
        isChecked() {
            return this.$el.value === this.value;
        },
        isEmpty() {
            return !this.value;
        },
        isCompleted() {
            if (!this.value) {
                return false;
            }

            return this.valid;
        },
        submitSelectedOptions(event) {
            if (!event.target.multiple) {
                this.submitValue(event);
                return;
            }

            if (!event.target.selectedOptions) {
                return;
            }

            const selectedOptions = [];
            Array.from(event.target.selectedOptions).forEach(selectedOption => {
                selectedOptions.push(selectedOption.value);
            });

            this.value = selectedOptions;
            this.submit();
        },
        submitValue(event) {
            if (this.value === event.target.value) {
                return;
            }

            this.value = event.target.value;
            this.submit();
        },
        submitChecked(event) {
            this.value = event.target.checked;
            this.submit();
        },
        async submit() {
            this.submitted = true;
            for ([key, callback] of Object.entries(this.validationActions)) {
                const result = await callback.bind(this).call();
                if (result === false) {
                    return false;
                }
            }

            this.beforeSubmit();
            this.post();
            this.afterSubmit();
        },
        afterSubmit() {
            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component: this}}));
        },
    };</script>