<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.2.48 */
/** @var Template $block */

?>
<script>
    const LokiFieldComponentType = {
        ...LokiComponentType,
        fieldName: '',
        fieldValue: null,
        disabled: false,
        submitted: false,
        required: false,
        requiredErrorMessage: false,
        validators: [],
        validationActions: {
            lokiComponentValidator() {
                return LokiComponentValidator.validate(this);
            }
        },
        initWatchFieldLoading() {
            if (this.$refs.field) {
                this.$refs.field.removeAttribute('aria-busy');

                if (!this.disabled) {
                    this.$refs.field.removeAttribute('disabled');
                }
            }

            this.$watch('loading', () => {
                if (!this.$refs.field) {
                    return;
                }

                if (this.loading) {
                    this.$refs.field.classList.add('loading');
                    this.$refs.field.setAttribute('aria-busy', true);
                } else {
                    this.$refs.field.classList.remove('loading');
                    this.$refs.field.removeAttribute('aria-busy');
                }
            });
        },
        initValidation() {
            if (this.required && !this.validators.includes('required')) {
                this.validators.push('required');
            }

            if (!this.isAriaInvalid()) {
                this.$refs.field && this.$refs.field.removeAttribute('aria-invalid');
            } else {
                this.$refs.field && this.$refs.field.setAttribute('aria-invalid', true);
            }

            this.$watch('valid', (newValue) => {
                if (!this.isAriaInvalid()) {
                    this.$refs.field && this.$refs.field.removeAttribute('aria-invalid');
                } else {
                    this.$refs.field && this.$refs.field.setAttribute('aria-invalid', true);
                }

                document.dispatchEvent(new CustomEvent('loki-components.component.update'));
            })
        },
        setValid(valid) {
            this.valid = valid;
            document.dispatchEvent(new CustomEvent('loki-components.component.update'));
        },
        isValid() {
            if (this.valid && !this.isEmpty()) {
                return true;
            }

            return this.valid && this.isSubmitted();
        },
        isAriaInvalid() {
            if (this.messages.filter(message => message.type === 'error').length > 0) {
                return true;
            }

            return !this.valid && this.submitted;
        },
        isSubmitted() {
            return this.submitted || this.ajax;
        },
        beforeSubmit() {
        },
        isChecked() {
            if (this.value === null || this.value === undefined) {
                return false;
            }

            return this.$el.value === String(this.value);
        },
        isEmpty() {
            if (this.value === null || this.value === undefined || this.value === false) {
                return true;
            }

            if (Array.isArray(this.value)) {
                return this.value.length === 0;
            }

            return String(this.value).trim() === '';
        },
        isCompleted() {
            if (this.isEmpty()) {
                return false;
            }

            return this.valid;
        },
        submitSelectedOptions(event) {
            if (!event.target.multiple) {
                this.submitValue(event);
                return;
            }

            if (!event.target.selectedOptions) {
                return;
            }

            const selectedOptions = [];
            Array.from(event.target.selectedOptions).forEach(selectedOption => {
                selectedOptions.push(selectedOption.value);
            });

            this.value = selectedOptions;
            this.submit();
        },
        submitValue(event) {
            if (this.value === event.target.value) {
                return;
            }

            this.value = event.target.value;
            this.submit();
        },
        submitChecked(event) {
            this.value = event.target.checked;
            this.submit();
        },
        async submit() {
            this.submitted = true;
            for (const callback of Object.values(this.validationActions)) {
                const result = await callback.bind(this).call();
                if (result === false) {
                    return false;
                }
            }

            this.beforeSubmit();
            this.post();
            this.afterSubmit();
        },
        afterSubmit() {
            document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component: this}}));
        },
    };
</script>
