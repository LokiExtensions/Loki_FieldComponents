<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.2.47 */
/** @var Template $block */

?>
<script>
    const LokiComboboxComponentPartial = {
        options: [],
        open: false,
        query: '',
        selectedValue: '',
        activeIndex: -1,
        placeholder: '',

        initCombobox() {
            if (!this.$refs.select) {
                return;
            }

            this.options = Array.from(this.$refs.select.options).map(option => ({
                value: option.value,
                label: option.text.trim(),
                disabled: option.disabled
            }));

            this.placeholder = this.options[0]?.value === '' ? this.options[0].label : this.placeholder;
            this.syncSelectedOption(this.$refs.select.value);

            this.$watch('value', (value) => {
                if (!this.open) {
                    this.syncSelectedOption(value);
                }
            });
        },

        syncSelectedOption(value) {
            const selected = this.options.find(option => String(option.value) === String(value ?? ''));
            this.selectedValue = selected ? selected.value : '';
            this.query = selected && selected.value !== '' ? selected.label : '';
        },

        filteredOptions() {
            const filtered = this.options.filter(option => !option.disabled && option.value !== '');
            const query = this.query.trim().toLowerCase();

            if (!query) {
                return filtered;
            }

            return filtered.filter(option => option.label.toLowerCase().includes(query));
        },

        onInput() {
            this.open = true;
            this.activeIndex = this.filteredOptions().length ? 0 : -1;

            if (this.query.trim() === '' && this.selectedValue !== '') {
                this.selectedValue = '';
                this.$refs.select.value = '';
                this.$refs.select.dispatchEvent(new Event('change', {bubbles: true}));
            }
        },

        openList() {
            if (this.open) {
                return;
            }

            this.open = true;
            this.activeIndex = this.filteredOptions().length ? 0 : -1;
        },

        closeList() {
            this.open = false;
            this.activeIndex = -1;
            this.syncSelectedOption(this.selectedValue);
        },

        toggle() {
            if (this.open) {
                this.closeList();
                return;
            }

            this.openList();
            this.$nextTick(() => this.$refs.input.focus());
        },

        moveDown() {
            if (!this.open) {
                this.openList();
                return;
            }

            const count = this.filteredOptions().length;
            if (!count) {
                return;
            }

            this.activeIndex = (this.activeIndex + 1) % count;
        },

        moveUp() {
            const count = this.filteredOptions().length;
            if (!this.open) {
                this.openList();
                this.activeIndex = count ? count - 1 : -1;
                return;
            }

            if (!count) {
                return;
            }

            this.activeIndex = (this.activeIndex - 1 + count) % count;
        },

        selectActive() {
            const option = this.filteredOptions()[this.activeIndex];
            if (this.activeIndex < 0 || !option) {
                return;
            }

            this.selectOption(option);
        },

        selectOption(option) {
            this.selectedValue = option.value;
            this.query = option.label;
            this.open = false;
            this.activeIndex = -1;

            this.$refs.select.value = option.value;
            this.$refs.select.dispatchEvent(new Event('change', {bubbles: true}));
        },
    };

    const LokiComboboxComponentType = {
        ...LokiFieldComponentType,
        ...LokiComboboxComponentPartial,
    };
</script>
