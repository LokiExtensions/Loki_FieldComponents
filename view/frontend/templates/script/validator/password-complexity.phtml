<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\ViewModel\PasswordComplexity;

/** @version 2.2.48 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var PasswordComplexity $passwordComplexity */

$passwordComplexity = $viewModelFactory->create(PasswordComplexity::class);
$minLengthError = __('Your password needs to have at least %1 characters.', $passwordComplexity->getMinimum());
$minNumError = __('Your password needs to contain at least %1 numbers.', $passwordComplexity->getMinimumNumeric());
$minOtherError = __('Your password needs to contain at least %1 non-alphanumeric characters.', $passwordComplexity->getMinimumOther());
?>
<script>
    LokiComponentValidator.validators.password_complexity = function (component) {
        const value = component.value === null || component.value === undefined ? '' : String(component.value);
        if (value === '') {
            return true;
        }

        if (Array.from(value).length < <?= (int)$passwordComplexity->getMinimum() ?>) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeJs((string)$minLengthError) ?>'});
            return false;
        }

        if (value.replace(/[^0-9]/g, '').length < <?= (int)$passwordComplexity->getMinimumNumeric() ?>) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeJs((string)$minNumError) ?>'});
            return false;
        }

        if (Array.from(value.replace(/[a-zA-Z0-9]/g, '')).length < <?= (int)$passwordComplexity->getMinimumOther() ?>) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeJs((string)$minOtherError) ?>'});
            return false;
        }

        return true;
    }
</script>
