<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\ViewModel\PasswordComplexity;

/** @version 2.2.8 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var PasswordComplexity $passwordComplexity */

$passwordComplexity = $viewModelFactory->create(PasswordComplexity::class);
$minLengthError = __('Your password needs to have more than %1 characters.', $passwordComplexity->getMinimum());
$minNumError = __('Your password needs to contain at least %1 numbers.', $passwordComplexity->getMinimumNumeric());
$minOtherError = __('Your password needs to contain at least %1 non-alphanumeric characters.', $passwordComplexity->getMinimumOther());
?>
<script>
    LokiComponentValidator.validators.password_complexity = function (component) {
        if (component.value.length < <?= $escaper->escapeHtml($passwordComplexity->getMinimum()) ?>) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeHtml($minLengthError) ?>'});
            return false;
        }

        if (component.value.replace(/[^0-9]/g, '').length < <?= $escaper->escapeHtml($passwordComplexity->getMinimumNumeric()) ?>) {
            console.log('Password', component.value, component.value.replace(/[^0-9]/g, '').length);
            component.messages.push({type:'error', text: '<?= $escaper->escapeHtml($minNumError) ?>'});
            return false;
        }

        if (component.value.replace(/[^a-zA-Z0-9]/g, '').length < <?= $escaper->escapeHtml($passwordComplexity->getMinimumOther()) ?>) {
            console.log('Password', component.value, component.value.replace(/[^0-9]/g, '').length);
            component.messages.push({type:'error', text: '<?= $escaper->escapeHtml($minOtherError) ?>'});
            return false;
        }

        return true;
    }
</script>
