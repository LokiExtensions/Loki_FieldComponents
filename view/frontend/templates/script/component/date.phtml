<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.0.16 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.directive('date-format', (el, { value, expression }, { evaluate }) => {
            if (!expression) {
                return;
            }

            const date = new Date(el.value);

            const map = {
                DD: String(date.getDate()).padStart(2, "0"),
                MM: String(date.getMonth() + 1).padStart(2, "0"),
                YYYY: date.getFullYear(),
                YY: String(date.getFullYear()).slice(-2),
            };

            const newFormat = expression.replace(/DD|MM|YYYY|YY/g, matched => map[matched]);
            console.log('new date format', newFormat);
            //el.textContent = newFormat
        });
    });
</script>
