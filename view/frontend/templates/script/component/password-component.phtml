<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.2.33 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiPassword', () => ({
            show: false,
            inputType: 'password',
            init() {
                this.$watch('show', () => {
                    this.inputType = this.show ? 'text' : 'password';
                });
            },
            isShown() {
                return this.show;
            },
            isHidden() {
                return !this.show;
            },
            toggle() {
                this.show = !this.show;
            }
        }));
    });
</script>
