<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.2.46 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiComboboxComponent', () => ({
            ...LokiComboboxComponentType,
        }));

        // UI-only state, to be nested inside an existing field component without overriding its value or methods
        Alpine.data('LokiCombobox', () => ({
            ...LokiComboboxComponentPartial,
            init() {
                this.initCombobox();
            },
        }));
    });
</script>
