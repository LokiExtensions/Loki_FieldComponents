<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiSwitch', () => ({
            labelClass() {
                return this.value ? 'right-[2px]' : 'left-[2px]';
            },
            toggleSwitch() {
                this.value = !this.value;
                this.post();
            }
        }));
    });
</script>
