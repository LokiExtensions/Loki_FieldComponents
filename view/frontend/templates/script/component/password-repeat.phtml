<?php
declare(strict_types=1);

/** @version 2.2.1 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiPasswordRepeat', () => ({
            show: false,
            inputType: 'password',
            password1: '',
            password2: '',
            init() {
                if (this.value) {
                    this.password1 = this.value;
                    this.password2 = this.value;
                }

                this.$watch('show', () => {
                    this.inputType = this.show ? 'text' : 'password';
                });
            },
            setPassword1(event) {
                this.password1 = event.target.value;
            },
            setPassword2(event) {
                this.password2 = event.target.value;
            },
            isShown() {
                return this.show;
            },
            isHidden() {
                return !this.show;
            },
            toggle() {
                this.show = !this.show;
            },
            matchPasswords() {
                if (this.password1 !== this.password2) {
                    this.messages.push({type:'error', text: '<?= $escaper->escapeHtml(__('Passwords do not match')) ?>'});
                    return;
                }

                this.value = this.password1;
                this.submit();
            }
        }));
    });
</script>
