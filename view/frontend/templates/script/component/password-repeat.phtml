<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiPasswordRepeat', () => ({
            show: false,
            inputType: 'password',
            password1: '',
            password2: '',
            init() {
                if (this.value) {
                    this.password1 = this.value;
                    this.password2 = this.value;
                }

                this.$watch('show', () => {
                    this.inputType = this.show ? 'text' : 'password';
                });
            },
            isShown() {
                return this.show;
            },
            isHidden() {
                return !this.show;
            },
            toggle() {
                this.show = !this.show;
            },
            matchPasswords() {
                if (this.password1 !== this.password2) {
                    return;
                }

                this.value = this.password1;
                this.submit();
            }
        }));
    });
</script>
