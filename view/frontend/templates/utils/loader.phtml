<?php
declare(strict_types=1);

use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var CssClass $css */
/** @var TemplateRenderer $templateRenderer */

$imageType = (string)$block->getImageType();
//$imageType = 'inline-svg';
if ($imageType === 'inline-svg') {
    echo $templateRenderer->html($block, 'Loki_FieldComponents::utils/loader/inline-svg.phtml');
    return;
}

echo $templateRenderer->html($block, 'Loki_FieldComponents::utils/loader/image.phtml');
