<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;

/** @version 2.2.48 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */

$size = $block->getSize() ?? 125;
$width = $block->getWidth() ?? $size;
$height = $block->getHeight() ?? $size;
?>
<img alt="<?= $escaper->escapeHtmlAttr(__('Loading')) ?>"
     src="<?= $escaper->escapeUrl($block->getViewFileUrl('Loki_FieldComponents::images/loader.svg')) ?>"
     class="<?= /* @noEscape */ $css('loader') ?>"
     width="<?= (int)$width ?>"
     height="<?= (int)$height ?>">
