<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.2.40 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */

$size = $block->getSize() ?? 20;

$icon = (string)$block->getIcon();
if (strlen($icon) < 1) {
    $icon = 'help';
}

$width = $block->getWidth();
if (empty($width)) {
    $width = 'absolute w-64';
}

$text = $block->getHelpText();

?>
<div
    role="tooltip"
    class="<?= /* @noEscape */ $css('ml-2 flex relative') ?>"
    x-data="LokiToggle"
    x-cloak>
    <button
        type="button"
        aria-label="<?= $escaper->escapeHtml('Help') ?>"
        @click.prevent="toggle"
        @keyup.escape="hide"
        class="<?= /* @noEscape */ $css('help', 'image') ?>">
        <?= /* @noEscape */ $imageRenderer->icon($block, $icon) ?>
    </button>

    <div
        x-cloak
        x-show="shown"
        @click.prevent="hide"
        @click.outside.prevent="hide"
        class="<?= $escaper->escapeHtml($width) ?> <?= /* @noEscape */ $css('absolute z-50 right-0 p-3 bg-zinc-400 text-white', 'popup') ?>">
        <button
            type="button"
            @click.prevent="toggle"
            aria-label="<?= $escaper->escapeHtml('Close help') ?>"
            class="<?= /* @noEscape */ $css('help float-right fill-white', 'popup-image') ?>">
            <?= /* @noEscape */ $imageRenderer->icon($block, $icon) ?>
        </button>
        <?= $escaper->escapeHtml(__($text)) ?>
    </div>
</div>
