<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var CssClass $css */
$size = (int)$block->getSize();
if ($size < 1) {
    $size = 20;
}

$width = $block->getWidth();
if (empty($width)) {
    $width = 'w-100';
}

$text = $block->getHelpText();
?>
<div class="<?= $css('inline relative') ?>" x-data="LokiToggle" x-cloak>
    <button type="button" @click="toggle">
        <img alt="<?= __('Show help') ?>"
             src="<?= $block->getViewFileUrl('Yireo_LokiFieldComponents::images/help.svg'); ?>"
             class="<?= $css('help', 'image') ?>"
             width="<?= $size ?>"
             height="<?= $size ?>">
    </button>

    <div x-cloak x-show="show" class="<?= $width ?> <?= $css('absolute z-50 right-0 p-3 bg-zinc-400 text-white', 'popup') ?>">
        <?= __($text) ?>
    </div>
</div>
