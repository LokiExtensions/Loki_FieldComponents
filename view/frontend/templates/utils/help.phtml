<?php
declare(strict_types=1);

/** @version 2.1.5 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;
use Loki\Field\ViewModel\ImageOutput;
use Loki\Components\Factory\ViewModelFactory;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */

$size = (int)$block->getSize();
if ($size < 1) {
    $size = 20;
}

$icon = (string)$block->getIcon();
if (strlen($icon) < 1) {
    $icon = 'Loki_FieldComponents::images/help.svg';
}

$width = $block->getWidth();
if (empty($width)) {
    $width = 'w-auto';
}

$text = $block->getHelpText();
$imageOutput = $viewModelFactory->create(ImageOutput::class);
?>
<div class="<?= /* @noEscape */ $css('ml-2 flex relative') ?>" x-data="LokiToggle" x-cloak>
    <button
        type="button"
        aria-label="<?= $escaper->escapeHtml('Help') ?>"
        @click.prevent="toggle"
        class="<?= /* @noEscape */ $css('help w-6', 'image') ?>">
        <?= /* @noEscape */ $imageOutput->get($icon) ?>
    </button>

    <div
        x-cloak
        x-show="shown"
        class="<?= $escaper->escapeHtml($width) ?> <?= /* @noEscape */ $css('absolute z-50 right-0 p-3 bg-zinc-400 text-white', 'popup') ?>">
        <button
            type="button"
            @click.prevent="toggle"
            aria-label="<?= $escaper->escapeHtml('Close help') ?>"
            class="<?= /* @noEscape */ $css('help float-right fill-white w-6', 'popup-image') ?>">
            <?= /* @noEscape */ $imageOutput->get($icon) ?>
        </button>
        <?= $escaper->escapeHtml(__($text)) ?>
    </div>
</div>
