<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_components"/>

    <body>
        <referenceContainer name="loki-scripts">
            <block
                name="loki-field-components.script.validator"
                template="Loki_FieldComponents::script/validator.phtml"/>

            <block
                name="loki-field-components.script.validators.password_complexity"
                template="Loki_FieldComponents::script/validator/password-complexity.phtml"/>
        </referenceContainer>

        <referenceContainer name="loki-component-types">
            <block
                name="loki-field-components.script.component-type.field"
                template="Loki_FieldComponents::script/component-type/field-component-type.phtml"/>
        </referenceContainer>

        <referenceContainer name="loki-components">
            <block
                name="loki-field-components.script.components.field-component"
                template="Loki_FieldComponents::script/component/field-component.phtml"/>

            <block
                name="loki-field-components.script.components.date"
                template="Loki_FieldComponents::script/component/date.phtml"/>

            <block
                name="loki-field-components.script.components.password"
                template="Loki_FieldComponents::script/component/password.phtml"/>

            <block
                name="loki-field-components.script.components.password-repeat"
                template="Loki_FieldComponents::script/component/password-repeat.phtml"/>
        </referenceContainer>

        <block
            name="loki-field-components.utils.loader"
            template="Loki_FieldComponents::utils/loader.phtml"/>

        <block
            name="loki-field-components.utils.loader-small"
            template="Loki_FieldComponents::utils/loader-small.phtml">
            <arguments>
                <argument name="size" xsi:type="number">20</argument>
            </arguments>
        </block>

        <block
            name="loki-field-components.utils.loader-overlay"
            template="Loki_FieldComponents::utils/loader-overlay.phtml">
            <arguments>
                <argument name="size" xsi:type="number">50</argument>
            </arguments>
        </block>

        <block
            name="loki-field-components.utils.required"
            template="Loki_FieldComponents::utils/required.phtml"/>

        <block name="loki-field-components.defaults.form.field">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="grid" xsi:type="string">col-span-12 md:col-span-6</item>
                    </item>
                </argument>
            </arguments>
        </block>

        <referenceBlock name="loki-components.alpinejs">
            <block
                name="loki-components.alpine-plugin-mask"
                template="Loki_FieldComponents::script/alpine-mask.phtml"
            />
        </referenceBlock>
    </body>
</page>
