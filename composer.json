{
    "name": "loki/magento2-field-components",
    "version": "2.2.45",
    "description": "Core module to allow fields to be defined via Loki Components",
    "keywords": [
        "loki-checkout-plan-trial",
        "loki-components"
    ],
    "type": "magento2-module",
    "require": {
        "ext-json": "*",
        "ext-pcre": "*",
        "loki/magento2-base": "^1.2",
        "loki/magento2-components": "^2.5",
        "loki/magento2-css-utils": "^1.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.0",
        "magento/module-media-storage": "^100.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
